
# Supabase Auth. The publishable (anon) key is meant to ship to browsers; the
# service-role key must never appear in frontend config.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in needs no key here — the client ID and secret live in the
# Supabase dashboard (Authentication > Providers > Google). Two URLs have to be
# registered for the round trip to complete:
#   - Google Cloud console, Authorised redirect URI:
#       https://your-project.supabase.co/auth/v1/callback
#   - Supabase, Authentication > URL Configuration > Redirect URLs:
#       <this app's origin>/auth/callback   (one entry per deployed origin)
